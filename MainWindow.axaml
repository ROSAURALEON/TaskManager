
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:TaskManager.Models"
        x:Class="TaskManager.MainWindow"
        Title="TaskManager - Gestor de Tareas"
        Width="950"
        Height="700"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*"
          Margin="20">

        <!-- Encabezado -->
        <StackPanel Grid.Row="0"
                    Spacing="5"
                    Margin="0,0,0,20">

            <TextBlock Text="TASK MANAGER"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Organiza tus actividades y administra tus tareas."
                       FontSize="14"/>

        </StackPanel>

        <!-- Contenido principal -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="20">

            <!-- Formulario de tareas -->
            <StackPanel Grid.Column="0"
                        Spacing="10">

                <TextBlock Text="Información de la tarea"
                           FontSize="20"
                           FontWeight="Bold"/>

                <TextBlock Text="Título"/>

                <TextBox x:Name="TxtTitulo"
                         Watermark="Escribe el título de la tarea"/>

                <TextBlock Text="Descripción"/>

                <TextBox x:Name="TxtDescripcion"
                         Watermark="Describe la tarea"
                         AcceptsReturn="True"
                         Height="80"
                         TextWrapping="Wrap"/>

                <TextBlock Text="Fecha de vencimiento"/>

                <TextBox x:Name="TxtFecha"
                         Watermark="AAAA-MM-DD"/>

                <TextBlock Text="Prioridad"/>

                <ComboBox x:Name="CmbPrioridad"
                          SelectedIndex="1">

                    <ComboBoxItem Content="Baja"/>
                    <ComboBoxItem Content="Media"/>
                    <ComboBoxItem Content="Alta"/>

                </ComboBox>

                <TextBlock Text="Estado"/>

                <ComboBox x:Name="CmbEstado"
                          SelectedIndex="0">

                    <ComboBoxItem Content="Pendiente"/>
                    <ComboBoxItem Content="Completada"/>

                </ComboBox>

                <!-- Botones CRUD -->

                <Button Content="Agregar tarea"
                        Click="Agregar_Click"
                        HorizontalAlignment="Stretch"
                        Margin="0,10,0,0"/>

                <Button Content="Actualizar tarea"
                        Click="Actualizar_Click"
                        HorizontalAlignment="Stretch"/>

                <Button Content="Eliminar tarea"
                        Click="Eliminar_Click"
                        HorizontalAlignment="Stretch"/>

                <Button Content="Limpiar formulario"
                        Click="Limpiar_Click"
                        HorizontalAlignment="Stretch"/>

            </StackPanel>

            <!-- Listado de tareas -->
            <StackPanel Grid.Column="1"
                        Spacing="10">

                <TextBlock Text="Mis tareas"
                           FontSize="20"
                           FontWeight="Bold"/>

                <TextBlock Text="Selecciona una tarea para consultar o modificarla."/>

                <ListBox x:Name="ListaTareas"
                         SelectionChanged="ListaTareas_SelectionChanged"
                         Height="450">

                    <ListBox.ItemTemplate>

                        <DataTemplate x:DataType="models:Tarea">

                            <Border BorderThickness="1"
                                    Padding="10"
                                    Margin="3">

                                <StackPanel Spacing="4">

                                    <TextBlock Text="{Binding Titulo}"
                                               FontWeight="Bold"
                                               FontSize="15"/>

                                    <TextBlock Text="{Binding Descripcion}"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding FechaVencimiento,
                                        StringFormat='Fecha: {0:yyyy-MM-dd}'}"/>

                                    <TextBlock Text="{Binding Prioridad,
                                        StringFormat='Prioridad: {0}'}"/>

                                    <TextBlock Text="{Binding Estado,
                                        StringFormat='Estado: {0}'}"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

                <!-- Mensajes de información y validación -->

                <TextBlock x:Name="TxtMensaje"
                           TextWrapping="Wrap"
                           Margin="5"
                           FontWeight="Bold"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>
